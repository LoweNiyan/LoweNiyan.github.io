---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={"NOT FOUND - " + SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .content {
        padding: 60px 20px;
        font-family: "Good Old DOS", monospace;
        font-size: 24px;
      }
    </style>
  </head>
  <body>
    <nav class="titlebar">
      <div class="tab">
        <span class="titletext">ERRRRRRROR!</span>
        <span class="closeicon">&#xE106;</span>
      </div>
      <div class="titleicons">
        <span class="titleicon icon1">&#xE921;</span>
        <span class="titleicon icon1">&#xE923;</span>
        <span class="titleicon icon2">&#xE8bb;</span>
      </div>
      <ul>
        <li><a href="/"><h4>首页</h4></a></li>
        <li><a href="/blog"><h4>BLOG</h4></a></li>
      </ul>
    </nav>

    <nav class="bottombar">
      <div class="right">
        <span class="progress">0%</span>
        <span class="back2top"><a href="#top" title="返回顶部">&#xE898</a></span>
      </div>
    </nav>

    <div class="content">
      404 - Not Found.
    </div>

    <div class="content cmdbox invisib" id="cmdbox">
      <form action="" autocomplete="off">
        <label class="cmdlabel">
          <input type="text" name="cmd" id="cmd" placeholder="> command">
          <input class="submit" type="submit" value="&#xE9AC;">
        </label>
      </form>
    </div>
  </body>
</html>
