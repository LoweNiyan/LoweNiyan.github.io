---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { notes } from '../content/notes';
import { resolveImage } from '../utils/images';
import '../style/moments.css';
import { pathHasLocale } from 'astro:i18n';

// 从 Content Collections 获取文章
const posts = await getCollection('blog');

// 序列化笔记数据，把原始图片路径换成 Astro 处理后的 hash URL
const notesData = notes.map((note) => ({
  ...note,
  image: resolveImage(note.image),
}));

// 序列化文章数据（含内容摘要用于弹窗）
const articleData = posts.map((post) => {
  // 取原始 body 的前 300 字作为弹窗内容
  const bodyText = (post.body || '')
    .replace(/<[^>]+>/g, '')
    .replace(/#{1,6}\s/g, '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_~`]/g, '')
    .trim();
  
  return {
    type: 'article',
    title: post.data.title,
    summary: post.data.summary,
    content: bodyText.slice(0, 300),
    date: post.data.pubDate.toISOString().split('T')[0],
    time: post.data.time || '',
    image: post.data.image ? post.data.image.src : '',
    url: `/blog/${post.id}`,
    author: post.data.author,
    tags: post.data.tags,
  };
});

const momentsData = JSON.stringify({ articles: articleData, notes: notesData });
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={"Moments - " + SITE_TITLE} description={SITE_DESCRIPTION} />
    <script src="../js/moments.js"></script>
  </head>
  <body>
    <!-- 注入数据给 moments.js 使用 -->
    <script id="moments-data" type="application/json" set:html={momentsData}></script>

    <div class="viewport-container" id="viewport_container">
      <div class="log-viewport">
        <a id="index_btn" class="index-btn">index</a>
        <div id="log_container" class="log-track"></div>

        <!-- 索引弹窗 -->
        <div id="index_overlay" class="index-overlay">
          <div class="index-page">
            <h1 class="index-title">索引</h1>
            <div class="index-content">
              <div id="index_list" class="index-list"></div>
              <div class="index-blank"></div>
            </div>
            <div class="index-mask"></div>
          </div>
        </div>

        <!-- 键盘提示 -->
        <div class="kb-hint"><kbd>←</kbd><kbd>→</kbd> 切换 &nbsp; <kbd>i</kbd> 索引 &nbsp; <kbd>Esc</kbd> 关闭</div>
      </div>

      <div class="modal-viewport">
        <!-- 弹窗（从底部滑入） -->
        <div id="modal" class="modal-overlay">
          <div class="modal-panel">
            <button class="modal-close">&times;</button>
            <h2 id="modal_title" class="modal-title"></h2>
            <time id="modal_time" class="modal-time"></time>
            <div id="modal_tags" class="modal-tags"></div>
            <div class="modal-scroll">
              <img id="modal_img" class="modal-img" src="" alt="">
              <div id="modal_body" class="modal-body"></div>
            </div>
            <a id="modal_link" class="modal-link" href="">阅读原文 →</a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
