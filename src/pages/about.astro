---
import BaseHead from '../components/BaseHead.astro';
import MiniNav from '../components/MiniNav.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const pageTitle = "About - " + SITE_TITLE;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
    <style>
      body {
        background: #000;
        color: #ddd;
        font-family: inherit;
        margin: 0;
      }
      main {
        max-width: 680px;
        margin: 0 auto;
        padding: 4em 1em;
        min-height: 100vh;
        box-sizing: border-box;
      }
    </style>
  </head>
  <body>
    <MiniNav>
      <main>
        <h1>关于</h1>
        <p>这里还没写东西喵～</p>
      </main>
    </MiniNav>
  </body>
</html>
