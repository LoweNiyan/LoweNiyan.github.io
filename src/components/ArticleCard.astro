---
import Tag from '../components/Tag.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  entry: {
    type: 'article';
    id: string;
    title: string;
    summary: string;
    content: string;
    date: string;
    time: string;
    image?: string;
    imageMeta?: ImageMetadata;
    url: string;
    author?: string;
    tags?: string[];
  };
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const loading = index < 4 ? 'eager' : 'lazy';
---

<div class="log-card-article" data-entry-id={entry.id}>
  <div class="card-img-wrap">
    {entry.imageMeta
      ? <Image src={entry.imageMeta} alt="" loading={loading} />
      : <span class="card-img-placeholder">+</span>
    }
  </div>

  <div class="card-title">{entry.title}</div>

  {entry.tags && entry.tags.length > 0 && (
    <div class="card-tags">
      {entry.tags.map((t) => <Tag tag={t} />)}
    </div>
  )}

  <div class="card-summary">{entry.summary}</div>
  <div class="card-info">
        {entry.author && <div class="card-author">{entry.author}</div>}
        <div class="card-time">{entry.time}</div>
  </div>

</div>

<style is:global>
.log-card-article {
    scroll-snap-align: center;
    flex-shrink: 0;
    width: min(480px, 78vw);
    min-height: 380px;
    padding: 24px;
    background: #0a0a0a;
    border: 1px solid #1a1a1a;
    border-radius: 2px;
    margin-right: 24px;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: border-color 0.3s, box-shadow 0.3s;
}
.log-card-article:hover {
    border-color: #ffffff55;
    box-shadow:
        0 0 40px  #ffffff66,
        0 0 100px #ffffff33,
        0 0 220px #ffffff14;
}
.log-card-article:hover img {
    position: relative;
    display: inline-block;
}
.log-card-article:hover img::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: var(--img);
    background-size: cover;
    background-position: center;
    filter: blur(18px) brightness(1.3);
    opacity: 0.7;
    z-index: -1;
    transform: scale(1.15);
}
.card-img-wrap {
    width: 100%;
    height: 200px;
    background: #111;
    border-radius: 1px;
    margin-bottom: 20px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}
.card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.card-img-placeholder {
    color: #2a2a2a;
    font-size: 48px;
    user-select: none;
}
.card-title {
    font-size: 20px;
    font-weight: bold;
    color: #ddd;
    font-family: var(--pixel-font);
}
.card-summary {
    font-size: 14px;
    color: #777;
    line-height: 1.7;
    flex: 1;
}

.card-tags {
    display: flex;
    align-items: center;
    margin-top: 5px;
    margin-bottom: 8px;
}
.card-author {
    display: inline-block;
    width: 50%;
    font-size: 13px;
    color: #666;
    margin-bottom: 4px;
}
.card-time {
    display: inline-block;
    width: 50%;
    font-size: 13px;
    color: #555;
    margin-top: 16px;
    text-align: right;
    font-family: var(--mono-font);
}
</style>
